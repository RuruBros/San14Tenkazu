<Project>
  <Target Name="ValidateGameBuildProfile" BeforeTargets="BeforeCompile" Condition="'$(MSBuildProjectName)' == 'San14Tenkazu.Core'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)BuildProfiles\Validate.ps1&quot;" />
  </Target>
  <Target Name="ValidateDeveloperPackage" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(LocalDeveloperPackage)' == 'true' and ('$(DeveloperPackageBuild)' != 'true' or '$(GITHUB_ACTIONS)' == 'true' or '$(PublicRelease)' == 'true')"
           Text="Developer menu is restricted to an explicit local developer build; public/GitHub builds must exclude it." />
  </Target>
</Project>
