<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the core engine: dotnet test source/Tests. The ones that need the game's exe or the running game
       skip themselves when it is not there. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>San14Tenkazu.Tests</AssemblyName>
    <RootNamespace>San14Tenkazu.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\San14Tenkazu.Core.csproj" />
    <!-- The archive reader uses only managed IO; exercise its real source without a WPF runtime. -->
    <Compile Include="..\KtglArchive.cs" Link="KtglArchive.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The formulas' vectors: the game's own code answered them in an emulator (source/Reverse/vectors). -->
    <None Include="Vectors\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="AiFriendVectors.json" CopyToOutputDirectory="PreserveNewest" />
